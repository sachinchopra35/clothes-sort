{
  "name": "clothes-sort",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:clothes": "node scripts/build-clothes-assets.mjs",
    "build:icon": "node scripts/build-app-icon.mjs",
    "build:music": "node scripts/build-music.mjs",
    "music:attribution": "node scripts/render-music-attribution.mjs",
    "music:attribution:check": "node scripts/render-music-attribution.mjs --strict",
    "levels:analyze": "vite-node scripts/levels-analyze.ts",
    "levels:generate": "vite-node scripts/levels-generate.ts",
    "levels:generate:more": "vite-node scripts/levels-generate.ts --more",
    "levels:generate:21": "vite-node scripts/levels-generate.ts --from=21",
    "levels:generate:23": "vite-node scripts/levels-generate.ts --from=23",
    "levels:generate:41": "vite-node scripts/levels-generate.ts --from=41",
    "levels:generate:61": "vite-node scripts/levels-generate.ts --from=61",
    "levels:generate:81": "vite-node scripts/levels-generate.ts --from=81",
    "levels:generate:86": "vite-node scripts/levels-generate.ts --from=86",
    "levels:generate:91": "vite-node scripts/levels-generate.ts --from=91",
    "levels:generate:96": "vite-node scripts/levels-generate.ts --from=96",
    "levels:generate:101": "vite-node scripts/levels-generate.ts --from=101",
    "levels:generate:106": "vite-node scripts/levels-generate.ts --from=106",
    "levels:generate:111": "vite-node scripts/levels-generate.ts --from=111",
    "levels:generate:116": "vite-node scripts/levels-generate.ts --from=116",
    "levels:generate:81-100": "npm run levels:generate:81 && npm run levels:generate:86 && npm run levels:generate:91 && npm run levels:generate:96"
  },
  "dependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  }
}
